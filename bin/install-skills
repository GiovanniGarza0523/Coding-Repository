#!/usr/bin/env bash
# install-skills — install or update Claude Code skills into ~/.claude/skills
#
# Usage:
#   bin/install-skills           # initial install (also updates if already present)
#   bin/install-skills --update  # explicit update flag (same behaviour)
#   bin/install-skills --help    # show this help
#
# What it does:
#   1. Clone or update the skills repo to  ~/.local/share/claude-skills
#   2. Sync the skills/ directory to       ~/.claude/skills/
#   3. Print a summary of what changed.

set -euo pipefail

# ── Configuration ────────────────────────────────────────────────────────────

SKILLS_REPO_URL="${CLAUDE_SKILLS_REPO:-https://github.com/GiovanniGarza0523/Coding-Repository.git}"
SKILLS_CACHE_DIR="${HOME}/.local/share/claude-skills"
SKILLS_TARGET_DIR="${HOME}/.claude/skills"

# ── Helpers ───────────────────────────────────────────────────────────────────

info()    { printf '\033[1;34m[skills]\033[0m %s\n' "$*"; }
success() { printf '\033[1;32m[skills]\033[0m %s\n' "$*"; }
warn()    { printf '\033[1;33m[skills]\033[0m %s\n' "$*" >&2; }
error()   { printf '\033[1;31m[skills]\033[0m %s\n' "$*" >&2; }

usage() {
  cat <<EOF
Usage: $(basename "$0") [--update] [--help]

Options:
  --update   Pull the latest skills from GitHub (default behaviour; kept for
             backward compatibility).
  --help     Show this help message and exit.

Environment variables:
  CLAUDE_SKILLS_REPO   Override the source repository URL.
                       Default: ${SKILLS_REPO_URL}

Target directories:
  Cache:   ${SKILLS_CACHE_DIR}
  Skills:  ${SKILLS_TARGET_DIR}
EOF
}

# ── Argument parsing ─────────────────────────────────────────────────────────

for arg in "$@"; do
  case "${arg}" in
    --help|-h) usage; exit 0 ;;
    --update)  ;; # accepted, no-op (we always update)
    *) error "Unknown argument: ${arg}"; usage; exit 1 ;;
  esac
done

# ── Step 1: Clone or update the source repo ───────────────────────────────────

if [[ -d "${SKILLS_CACHE_DIR}/.git" ]]; then
  info "Updating cached repo at ${SKILLS_CACHE_DIR} …"
  git -C "${SKILLS_CACHE_DIR}" pull --ff-only --quiet
  info "Repository updated."
else
  info "Cloning ${SKILLS_REPO_URL} → ${SKILLS_CACHE_DIR} …"
  mkdir -p "$(dirname "${SKILLS_CACHE_DIR}")"
  git clone --depth 1 --quiet "${SKILLS_REPO_URL}" "${SKILLS_CACHE_DIR}"
  info "Repository cloned."
fi

SKILLS_SOURCE_DIR="${SKILLS_CACHE_DIR}/skills"

if [[ ! -d "${SKILLS_SOURCE_DIR}" ]]; then
  error "skills/ directory not found in ${SKILLS_CACHE_DIR}."
  error "The repository at ${SKILLS_REPO_URL} may not contain a skills/ directory."
  exit 1
fi

# ── Step 2: Sync skills to target directory ───────────────────────────────────

mkdir -p "${SKILLS_TARGET_DIR}"

changed_count=0
skipped_count=0
backed_up_count=0

while IFS= read -r -d '' src_file; do
  # Compute the relative path inside skills/
  rel_path="${src_file#"${SKILLS_SOURCE_DIR}/"}"
  dst_file="${SKILLS_TARGET_DIR}/${rel_path}"

  # Ensure parent directory exists
  mkdir -p "$(dirname "${dst_file}")"

  if [[ -e "${dst_file}" ]]; then
    if cmp -s "${src_file}" "${dst_file}"; then
      # Files are identical — skip
      (( skipped_count += 1 ))
      continue
    fi
    # Files differ — back up the existing file once (timestamped)
    backup="${dst_file}.bak.$(date +%Y%m%d%H%M%S)"
    cp -a "${dst_file}" "${backup}"
    warn "Conflict: backed up existing file → ${backup}"
    (( backed_up_count += 1 ))
  fi

  cp -a "${src_file}" "${dst_file}"
  info "  installed: ${rel_path}"
  (( changed_count += 1 ))
done < <(find "${SKILLS_SOURCE_DIR}" -type f -print0)

# ── Step 3: Summary ───────────────────────────────────────────────────────────

echo ""
success "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
success " Install complete"
success "  • Installed / updated : ${changed_count} file(s)"
success "  • Already up-to-date  : ${skipped_count} file(s)"
[[ "${backed_up_count}" -gt 0 ]] && \
  success "  • Conflicts backed up : ${backed_up_count} file(s)"
success ""
success " Skills location: ${SKILLS_TARGET_DIR}"
success "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

info "To verify, run:"
echo "    find \"${SKILLS_TARGET_DIR}\" -type f | sort"
